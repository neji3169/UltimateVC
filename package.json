{
  "name": "ultimate-vc",
  "productName": "UltimateVC",
  "description": "Ultra low-latency, high-fidelity real-time voice changer with RVC v2 inference and RTX acceleration.",
  "private": true,
  "version": "2.0.0",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "desktop": "electron main.cjs",
    "start": "electron main.cjs",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.vonovox.ultimatevc",
    "productName": "UltimateVC",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
